# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha2"
synopsis: "Unix transport for the java-tron HTTP client"
description: """
Tron_rpc_flow.Make over a Unix descriptor or a verified TLS flow. HTTPS
uses the system CA store, hostname verification and SNI; the pure and Mirage
flow packages remain free of Unix/TLS dependencies."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "tron-rpc" {= version}
  "tron-rpc-flow" {= version}
  "tron-transaction" {= version}
  "tron-crypto" {= version}
  "lwt" {>= "5.6.0"}
  "mirage-flow" {>= "4.0.0"}
  "mirage-flow-unix" {>= "4.0.0"}
  "tls" {>= "2.0.0"}
  "tls-lwt" {>= "2.0.0"}
  "x509"
  "ca-certs"
  "cstruct"
  "fmt"
  "uri" {>= "4.2.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
