# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Java-tron HTTP over any Mirage_flow.S, including Solo5 vsock"
description: """
The HTTP/1.1 framing lives here as a pure parser and the client is a functor
over Mirage_flow.S; this package owns the socket. Functorising over a flow
rather than over an HTTP client is not a preference: the confidential Solo5
targets forbid NET_BASIC outright, and sptmac has no networking at all, so
vsock is the only transport available there. TLS composes as Tls_mirage.Make
over the same signature."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "tron-rpc" {= version}
  "lwt" {>= "5.6.0"}
  "cstruct" {>= "6.0.0"}
  "mirage-flow" {>= "4.0.0"}
  "fmt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
