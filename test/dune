; Cross-oracle: where TronWeb and trident agree, ocaml-tron must match both;
; where they disagree, the disagreement is asserted rather than resolved by
; picking a favourite.

(test
 (name test_conformance)
 (modules test_conformance fixture_conf)
 (package tron)
 (deps
  (glob_files ../conformance/fixtures/*.json))
 (libraries tron-types tron-crypto tron-transaction alcotest))

; The G6 gate: HTTP and gRPC must decode to the same values. No socket -- each
; transport's decoder is fed a body the node would have sent, and the results
; are compared.

(test
