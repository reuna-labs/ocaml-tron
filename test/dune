; The crypto tests read the conformance fixtures, so dune has to copy them into
; the build tree. They are data_only_dirs at the root, which is what stops dune
; looking for dune files inside conformance/.

(test
 (name test_crypto)
 (modules test_crypto fixture)
 (package tron-crypto)
 (deps
  (glob_files ../conformance/fixtures/*.json))
 (libraries tron-types tron-crypto alcotest))

