# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha2"
synopsis: "Pure OCaml Tron SDK for clients and signers"
description: """
The offline surface: types, crypto, generated wire bindings, transaction
construction and the typed RPC protocol. Transports are deliberately absent --
tron-rpc-flow and tron-rpc-unix are separate packages so that a consumer
linking this one takes on no Lwt, no Unix and no socket."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "tron-types" {= version}
  "tron-crypto" {= version}
  "tron-proto" {= version}
  "tron-transaction" {= version}
  "tron-rpc" {= version}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "crowbar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
# Development pins for the coordinated native crypto source.
# Pins select versions; optional packages are installed only when required.
pin-depends: [
  [ "mirage-crypto.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#edeae749daa6f8eafb73446e68e654d00794e898" ]
  [ "mirage-crypto-rng.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#edeae749daa6f8eafb73446e68e654d00794e898" ]
  [ "mirage-crypto-secp256k1.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#edeae749daa6f8eafb73446e68e654d00794e898" ]
  [ "mirage-crypto-pk.2.4.0" "git+https://github.com/reuna-labs/mirage-crypto.git#edeae749daa6f8eafb73446e68e654d00794e898" ]
  [ "digestif.1.4.0" "git+https://github.com/reuna-labs/digestif.git#770f9c355bd5fd60ebf63027b66a51920906519f" ]
  [ "web3-codec-basen.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-web3-codec.git#v0.1.0-alpha1" ]
  [ "web3-codec-base58.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-web3-codec.git#v0.1.0-alpha1" ]
  [ "web3-codec-protobuf.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-web3-codec.git#v0.1.0-alpha1" ]
  [ "evm-types.0.2.0~alpha1" "git+https://github.com/reuna-labs/ocaml-evm.git#v0.2.0-alpha1" ]
  [ "evm-abi.0.2.0~alpha1" "git+https://github.com/reuna-labs/ocaml-evm.git#v0.2.0-alpha1" ]
  [ "grpc.0.2.1~alpha1" "git+https://github.com/reuna-labs/ocaml-grpc.git#v0.2.1-alpha1" ]
  [ "grpc-lwt.0.2.1~alpha1" "git+https://github.com/reuna-labs/ocaml-grpc.git#v0.2.1-alpha1" ]
]
