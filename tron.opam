# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Pure OCaml Tron SDK for clients and signers"
description: """
The offline surface: types, crypto, generated wire bindings, transaction
construction and the typed RPC protocol. Transports are deliberately absent --
tron-rpc-flow and tron-rpc-unix are separate packages so that a consumer
linking this one takes on no Lwt, no Unix and no socket."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "tron-types" {= version}
  "tron-crypto" {= version}
  "tron-proto" {= version}
  "tron-transaction" {= version}
  "tron-rpc" {= version}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "crowbar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
# DEVELOPMENT ONLY -- delete this file before submitting to opam-repository.
#
# Every one of these is a Reuna fork or an unreleased sibling, so a standalone
# `opam install --deps-only .` cannot solve without them. That they are needed
# at all is the G0 launch gate -- "no opam file points to a private repository"
# -- which this repository does not clear. Recording it here rather than
# omitting it keeps the gap visible.
#
# dune regenerates tron.opam from dune-project and silently drops whatever
# follows. Re-append this block after any regeneration, or the package solves
# against released mirage-crypto, which has no Secp256k1 and no Keccak256.

pin-depends: [
  [ "mirage-crypto.dev" "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1" ]
  [ "mirage-crypto-rng.dev" "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1" ]
  [ "mirage-crypto-ec.dev" "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1" ]
  [ "mirage-crypto-blockchain.dev" "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1" ]
  [ "digestif.dev" "git+https://github.com/reuna-labs/digestif.git#release/1.4.0-alpha1" ]
  [ "web3-codec-basen.dev" "git+https://github.com/reuna-labs/ocaml-web3-codec.git" ]
  [ "web3-codec-base58.dev" "git+https://github.com/reuna-labs/ocaml-web3-codec.git" ]
  [ "web3-codec-protobuf.dev" "git+https://github.com/reuna-labs/ocaml-web3-codec.git" ]
  [ "evm-types.dev" "git+https://github.com/reuna-labs/ocaml-evm.git" ]
  [ "evm-abi.dev" "git+https://github.com/reuna-labs/ocaml-evm.git" ]
  # grpc.0.2.0 caps h2 < 0.13.0, and the Mirage-capable h2 is 0.13.0. The fix
  # is staged in the private Reuna mirror pending an upstream release. Only
  # tron-rpc-grpc needs it.
  [ "grpc.dev" "git+https://github.com/reuna-labs/ocaml-grpc.git#main" ]
  [ "grpc-lwt.dev" "git+https://github.com/reuna-labs/ocaml-grpc.git#main" ]
]
