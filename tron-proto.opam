# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Generated protobuf bindings for the Tron protocol"
description: """
Bindings generated with ocaml-protoc-plugin from the .proto tree vendored at
proto/, pinned to tronprotocol/protocol 8432bec. The generated sources are
committed, so building this package requires neither protoc nor the plugin.

Depends only on web3-codec-protobuf, whose closure is base64 + ptime, and in
particular not on unix, so it links into a MirageOS/Solo5 unikernel.

These are wire types, not a validated model. Transaction.Contract.parameter is
a google.protobuf.Any that the generated code cannot narrow; narrowing it is
tron-transaction's job."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "web3-codec-protobuf" {>= "0.1.0~alpha1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
