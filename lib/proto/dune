; The generated protobuf bindings and the google.protobuf.Any they reference.
;
; include_subdirs flattens gen/ and gen/google_types/ into this one library,
; which is what makes the cross-file references the plugin emits --
; Any.Google.Protobuf.Any, and Runtime' = Ocaml_protoc_plugin -- resolve
; without qualification. The runtime itself is not here: it is
; web3-codec-protobuf in ocaml-web3-codec.
;
; The sources under gen/ are generated by docs/protocol-pin.md's recipe and
; committed, so building this needs neither protoc nor ocaml-protoc-plugin.
; Do not edit them.

(include_subdirs unqualified)

(library
 (name tron_proto)
 (public_name tron-proto)
 ; Generated code is not ours to lint. The dev profile promotes warnings to
 ; errors and it trips several by design.
 (flags
  (:standard -w -a))
 (libraries web3-codec-protobuf))
