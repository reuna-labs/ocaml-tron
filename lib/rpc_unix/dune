; Tron_rpc_flow.Make applied to a Unix descriptor or a verified TLS flow, plus
; dialling. TLS stays in this Unix adapter so the pure and Mirage flow packages
; retain their smaller, host-independent closure.
;
; Dialling lives here rather than one layer up on purpose: a unikernel's
; connection comes from a device it owns, and putting a getaddrinfo into
; tron-rpc-flow would be a Unix dependency in the one layer that must not have
; one.

(library
 (name tron_rpc_unix)
 (public_name tron-rpc-unix)
 (libraries
  tron-rpc
  tron-rpc-flow
  lwt
  lwt.unix
  unix
  mirage-flow
  mirage-flow-unix
  tls
  tls-lwt
  x509
  ca-certs
  uri
  cstruct
  fmt))
