# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha2"
synopsis: "Secp256k1 recoverable signing for Tron"
description: """
Signs the 32-byte SHA-256 digest of a serialized raw_data and produces Tron's
65-byte r-s-v wire signature, where v is the raw recovery id.

Secret-dependent curve operations use mirage-crypto-ec's fiat-crypto P256k1
backend. Recovery, which runs on public data, uses mirage-crypto-blockchain's
reference implementation -- which is documented NOT CONSTANT TIME and must
never be handed a secret key. This split follows ocaml-evm's evm-crypto.

No RNG: nonces are RFC 6979 deterministic."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "tron-types" {= version}
  "digestif" {>= "1.2.0"}
  "mirage-crypto-ec" {>= "2.1.0"}
  "mirage-crypto-blockchain"
  "zarith" {>= "1.12"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
