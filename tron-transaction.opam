# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Tron transaction construction, signing and intent"
description: """
Builds raw_data locally, hashes it to a txID, signs it and renders the
broadcast form. The node is never asked to build a transaction this library
will sign.

The contract set is a closed OCaml variant over google.protobuf.Any; anything
unrecognised decodes as opaque and can never satisfy a policy. The intent
layer derives a reviewable meaning from the serialized bytes -- never from the
builder's inputs -- and reports permission id, fee limit and expiration as
first-class fields.

TVM contract calls reuse the Ethereum Contract ABI from evm-abi."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-tron"
bug-reports: "https://github.com/reuna-labs/ocaml-tron/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "tron-types" {= version}
  "tron-crypto" {= version}
  "tron-proto" {= version}
  "evm-abi" {>= "0.1.0"}
  "digestif" {>= "1.2.0"}
  "zarith" {>= "1.12"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-tron.git"
